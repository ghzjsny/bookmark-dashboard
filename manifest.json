{
  "manifest_version": 3,
  "name": "书签导航 · Bookmark Dashboard",
  "version": "1.0.0",
  "description": "读取浏览器书签，生成 WeTab 风格导航面板，支持点击跳转、查看与编辑。",
  "permissions": ["bookmarks", "storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "打开书签导航",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
